# FYERS API credentials — keep the real values only in your local .env file.
FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=http://localhost:8080/
FYERS_ACCESS_TOKEN=

# Safe defaults: no live orders are allowed.
TRADING_MODE=PAPER
AUTO_EXECUTE=false
ALLOW_LIVE_TRADING=false

# Risk and storage settings.
STARTING_CAPITAL=30000
MAX_CAPITAL_PER_TRADE=12000
GAMMA_DB_PATH=gamma_blast_fyers.db

# Momentum-quality filters. Tune only after out-of-sample backtesting.
MIN_HA_BODY_ATR=0.10
MAX_BREAKOUT_ATR=0.75
MIN_CLOSE_LOCATION=0.70
RSI_PERIOD=14
BULLISH_RSI_MIN=55
BEARISH_RSI_MAX=45
