# FYERS API credentials — keep the real values only in your local .env file.
FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=http://localhost:8080/
FYERS_ACCESS_TOKEN=

# Safe defaults: no live orders are allowed.
TRADING_MODE=PAPER
AUTO_EXECUTE=false
ALLOW_LIVE_TRADING=false

# Risk and storage settings.
STARTING_CAPITAL=30000
MAX_CAPITAL_PER_TRADE=12000
GAMMA_DB_PATH=gamma_blast_fyers.db

# Momentum-quality filters. Tune only after out-of-sample backtesting.
MIN_HA_BODY_ATR=0.10
MAX_BREAKOUT_ATR=0.75
MIN_CLOSE_LOCATION=0.70
RSI_PERIOD=14
BULLISH_RSI_MIN=55
BEARISH_RSI_MAX=45

# Strategy selection and v2 research defaults (v1 remains the default).
STRATEGY_VERSION=v1
ALL_SIGNALS=false
BACKTEST_DAYS=expiry
TRAIN_FRACTION=0.7
MAP_TIME=13:30
RANGE_LOOKBACK_EXPIRIES=20
STRADDLE_BARS=2
STRADDLE_MIN_CHANGE_PCT=0
WALL_OI_DROP_PCT=3
VELOCITY_BARS=3
VELOCITY_STRADDLE_MULT=0.6
FUT_VOL_MULT=2.0
MAX_RANGE_PERCENTILE=60
MIN_SCORE=4
V2_ENTRY_START=14:00
V2_ENTRY_END=15:05
MAX_TRADES_PER_EXPIRY=1
TARGET_DELTA=0.42
DELTA_MIN=0.35
DELTA_MAX=0.50
RISK_FREE_RATE=0.065
MAX_SPREAD_PCT=5
MAX_LOSS_PER_EXPIRY_RS=2000
V2_INITIAL_STOP=0.35
TIME_STOP_TARGET_PCT=40
TIME_STOP_MINUTES=9
SCALE_OUT_PCT=100
SCALE_OUT_FRACTION=0.5
V2_TRAIL_PCT=30
STRADDLE_EXIT_BARS=2
V2_HARD_EXIT=15:20
SCALE_IN=false
SLIPPAGE_TICKS=1
COST_BROKERAGE_PER_ORDER=20
COST_STT_SELL_PCT=0.1
COST_EXCHANGE_PCT=0.03503
COST_SEBI_PCT=0.0001
COST_STAMP_BUY_PCT=0.003
COST_GST_PCT=18
